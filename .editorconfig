root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml,md,js,jsx,ts,tsx,mjs,cjs,mts,cts,css,scss,less,html,svg,astro}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[*.go]
indent_style = tab
indent_size = tab
tab_width = 8

[{Makefile,makefile,GNUmakefile,*.mk,.gitmodules,.gitconfig}]
indent_style = tab
indent_size = tab
tab_width = 4

[*.java]
indent_style = space
ij_continuation_indent_size = 4
ij_java_blank_lines_before_class_end = 0
ij_java_blank_lines_after_anonymous_class_header = 0
ij_java_blank_lines_after_class_header = 0
ij_java_blank_lines_before_method_body = 0
ij_java_else_on_new_line = false
ij_java_class_count_to_use_import_on_demand = 999
ij_java_names_count_to_use_import_on_demand = 999
ij_java_imports_layout = $*,|,java.**,|,javax.**,|,org.**,|,com.**,|,*,|,net.fabricmc.**,|,io.github.fabricators_of_create.**
ij_java_insert_inner_class_imports = true
